     /S /P
     /Pg 850 0 R
     /Type /StructElem
  >>
endobj

868 0 obj
  << /ActualText (The evidence shows that assistants often mediate bookings in our selected context\054 while some needs emerge only during the stay\056 It also shows that trusted calls can already work well\054 some private needs are deliberately withheld\054 and MO already has preference records and service guidance\056)
     /K [ 9 ]
     /P 869 0 R
     /Pg 850 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

