702 0 obj
  << /ActualText (We also rejected automatic promises of bespoke service\056 Suggested plans must remain provisional until the relevant people confirm capacity\054 cost and timing\056 A declined or revised plan needs a visible explanation\056)
     /K [ 11 ]
     /P 703 0 R
     /Pg 680 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

703 0 obj
  << /K [ 702 0 R ]
     /P 716 0 R
     /S /P
     /Pg 680 0 R
     /Type /StructElem
  >>
endobj

704 0 obj
  << /ActualText (We paired online preparation with in\055person discovery\056 The Dream Maker workspace structures a possible act of care into a plan\054 approval\054 departmental feasibility check\054 execution and review\056 It is intended to make learning reusable without removing individual judgement\056)
     /K [ 12 ]
     /P 705 0 R
     /Pg 680 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

