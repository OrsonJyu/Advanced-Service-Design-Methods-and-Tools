  << /K [ 876 0 R ]
     /P 916 0 R
     /S /P
     /Pg 864 0 R
     /Type /StructElem
  >>
endobj

878 0 obj
  << /ActualText (The guest and agent research shifted our attention towards the person representing the staying guest\056 An assistant might know routines and schedules but still need to recognise which hotel arrangements were possible\056 This gave us a reason to explore visible\054 concrete choices rather than only an empty text field\056)
     /K [ 7 ]
     /P 879 0 R
     /Pg 864 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

